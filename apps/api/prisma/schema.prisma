// Prisma Schema para o Caderno de Dívidas
// Documentação: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id             String        @id @default(uuid())
  name           String
  avatarInitials String
  primaryColor   String
  secondaryColor String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  pinHash        String?
  pinAttempts    Int           @default(0)
  pinAttemptUntil DateTime?
  transactions   Transaction[]
  sessions       ProfileSession[]
  shoppingItems  ShoppingItem[]

  @@map("profiles")
}

model ShoppingItem {
  id                     String    @id @default(uuid())
  profileId              String
  name                   String
  estimatedAmount        Float?
  paymentMethod          String?
  installmentCount       Int?
  scheduledDate          String?
  actualAmount           Float?
  actualPaymentMethod    String?
  actualInstallmentCount Int?
  actualDate             String?
  transactionId          String?
  groupId                String?
  createdAt              DateTime  @default(now())
  purchasedAt            DateTime?
  archivedAt             DateTime?
  revision               Int       @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@map("shopping_items")
}

model ProfileSession {
  tokenHash String   @id
  profileId String
  expiresAt DateTime
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, expiresAt])
  @@map("profile_sessions")
}

model Transaction {
  id                 String    @id @default(uuid())
  profileId          String
  type               String    // 'income' | 'expense'
  category           String    // 'fixed' | 'recurring' | 'installment' | 'daily'
  amount             Float
  description        String
  date               DateTime
  currentInstallment Int?
  totalInstallments  Int?
  groupId            String?   // UUID que agrupa todas as parcelas da mesma dívida/compra
  status             String    @default("pending") // 'pending' | 'paid' | 'overdue'
  paymentDate        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  profile            Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, date])
  @@index([date])
  @@index([groupId])
  @@index([category])
  @@index([type])
  @@map("transactions")
}
