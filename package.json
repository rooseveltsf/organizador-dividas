{
  "name": "organizador-dividas",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo para o sistema de Organizador de Dívidas e Finanças Pessoais",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,magenta\" \"npm run dev -w @organizador/api\" \"npm run dev -w @organizador/web\"",
    "dev:all": "concurrently -n \"SHARED,API,WEB\" -c \"yellow,cyan,magenta\" \"npm run dev -w @organizador/shared\" \"npm run dev -w @organizador/api\" \"npm run dev -w @organizador/web\"",
    "dev:api": "npm run dev -w @organizador/api",
    "dev:web": "npm run dev -w @organizador/web",
    "dev:shared": "npm run dev -w @organizador/shared",
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "keywords": [
    "monorepo",
    "financas",
    "workspaces",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
